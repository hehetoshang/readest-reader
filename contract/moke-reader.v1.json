{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "moke.readest.embed.v1",
  "readerBasePath": "/readest",
  "readerRoute": "/readest/reader",
  "progressSchema": "moke.readest.progress.v1",
  "capabilities": [
    "moke.readest.host-launch.v1",
    "moke.readest.resource-base.v1",
    "moke.readest.progress-identity.v1"
  ],
  "hostLaunch": {
    "contract": "reader-host-launch.v1.json",
    "queryLookup": "mokeLaunchId",
    "claimBefore": ["reader-mount", "http", "progress-restore"],
    "resourceAuthority": "exact sealed URL from native caller-bound claim",
    "progressOwner": "host",
    "remoteRestoreSnapshot": false,
    "persistentIdentity": "JSON.stringify([canonicalOriginalLibraryBaseUrl, String(bookId)])",
    "productionGate": "host-controlled; full-document/mobile ownership requires platform validation"
  },
  "launchParameters": {
    "file": {
      "required": false,
      "repeatable": true,
      "description": "Legacy host-authorized local book path; prohibited with mokeLaunchId"
    },
    "mokeLaunchId": {
      "required": false,
      "description": "Native caller-bound claim lookup only; grants no authority"
    },
    "moke": { "required": true, "constant": "1" },
    "mokeBookId": { "required": false },
    "mokeServerUrl": { "required": false, "protocols": ["http", "https"] },
    "mokeSourceServerUrl": {
      "required": false,
      "protocols": ["http", "https"],
      "description": "Legacy metadata only; cannot authorize HTTP"
    },
    "mokeRestoreProgress": { "required": false, "encoding": "JSON" },
    "mokeReturnTo": { "required": false, "allowed": ["/library"] },
    "mokeEink": { "required": false, "allowed": ["0", "1"] },
    "mokeDebug": { "required": false, "allowed": ["0", "1"] }
  },
  "hostCommands": ["ext_reader_event", "moke_navigate", "moke_runtime_platform"],
  "readerEvents": [
    "book:opened",
    "book:closed",
    "page:changed",
    "reader:error",
    "annotation-locate:finished"
  ],
  "onlineSource": {
    "formats": ["epub"],
    "pathTemplate": "{effectiveBaseUrl}/read/resource/{mokeBookId}.epub?revision={revision}",
    "legacyPathTemplate": "{effectiveBaseUrl}/api/book/{mokeBookId}.epub",
    "mime": "application/epub+zip",
    "acceptedLegacyResponseMimes": ["application/epub+zip", "application/octet-stream"],
    "rangeRequired": true,
    "redirects": 0,
    "transport": "@tauri-apps/plugin-http"
  },
  "progressApi": {
    "method": "POST",
    "pathTemplate": "/api/book/{mokeBookId}/progress",
    "credentials": "include",
    "bodyProperty": "progress",
    "successErrValues": ["", "ok"],
    "transport": "@tauri-apps/plugin-http"
  },
  "nativeLibrary": {
    "crate": "readestlib",
    "defaultFeatures": false,
    "registrationFunctions": [
      "register_reader_plugins",
      "register_reader_protocols",
      "reader_invoke_handler",
      "manage_reader_state"
    ]
  }
}
